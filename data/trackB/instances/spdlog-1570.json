  "issue": {
    "title": "daily_file_sink has deadlock bug",
    "body": "The `sink_it` function of `daily_file_sink` runs under a lock, however it can call `delete_old_`, which internally calls `filename()`. `filename()` tries to acquire the lock, which is already held open. This leads to deadlock.\r\n\r\nHappy to fix.",
    "url": "https://github.com/gabime/spdlog/issues/1570",
    "rewritten": false,
    "mentions_fix": false
  },
