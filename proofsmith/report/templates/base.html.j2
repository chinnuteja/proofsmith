<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Proofsmith{% endblock %}</title>
  <link rel="icon" href="data:,">
  <link rel="stylesheet" href="/site.css">
</head>
<body>
  <header class="site-header">
    <div class="wrap header-row">
      <a class="brand" href="/" data-testid="brand">Proofsmith</a>
      <nav data-testid="nav" aria-label="Primary">
        <a href="/" data-testid="nav-toolchain">Toolchain</a>
        {% if show_demo %}<a href="/demo/" data-testid="nav-demo">Demo</a>{% endif %}
      </nav>
    </div>
  </header>
  <main class="wrap">
    {% block body %}{% endblock %}
  </main>
  <footer class="site-footer">
    <div class="wrap" data-testid="footer">git <span data-testid="git-sha">{{ git_sha }}</span></div>
  </footer>
</body>
</html>
