<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="icon" href="data:,"><title>Proofsmith · {{ receipt.status }}</title>
<style>
:root{color-scheme:dark;--bg:#0b1118;--card:#131e2b;--text:#e8eef5;--muted:#aab8c8;--line:#2c3a4c;--accent:#91efbd}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:16px/1.6 system-ui,sans-serif}main{max-width:1100px;margin:auto;padding:40px 24px}a{color:var(--accent)}.eyebrow{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--accent)}h1{font-size:clamp(32px,5vw,58px);line-height:1.1;margin:20px 0}h2{font-size:23px}p{max-width:80ch}.muted{color:var(--muted)}.status{display:inline-block;padding:6px 12px;border:1px solid var(--line);border-radius:6px;font-weight:700}.VERIFIED{color:#91efbd}.REJECTED{color:#ffae98}.INCONCLUSIVE{color:#ffdd91}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:16px;margin:28px 0}.card{background:var(--card);padding:24px;border:1px solid var(--line);border-radius:12px}.metric{font-size:40px;font-weight:700;line-height:1.2}.card h2{margin-top:0}code,pre{font:13px/1.65 ui-monospace,Consolas,monospace;overflow-wrap:anywhere}pre{background:#070c12;padding:18px;border-radius:8px;white-space:pre-wrap;max-height:460px;overflow:auto}details{margin:14px 0}summary{cursor:pointer;color:var(--accent)}table{border-collapse:collapse;width:100%;font-size:13px}td,th{text-align:left;padding:8px;border-bottom:1px solid var(--line)}.table-wrap{overflow:auto}dl{display:grid;grid-template-columns:150px minmax(0,1fr);gap:8px}dt{color:var(--muted)}dd{margin:0;overflow-wrap:anywhere}.footer{border-top:1px solid var(--line);margin-top:40px;padding-top:20px;font-size:13px;color:var(--muted)}@media(max-width:600px){main{padding:24px 16px}dl{grid-template-columns:1fr;gap:4px}dd{margin-bottom:12px}}
</style></head><body><main>
<p class="eyebrow">Proofsmith / evidence before approval</p>
<span class="status {{ receipt.status }}" data-testid="status">{{ receipt.status }}</span>
<h1>{% if receipt.operation == 'seal' %}Freeze the failure.{% elif receipt.status == 'VERIFIED' %}The original failure is gone.{% elif receipt.status == 'REJECTED' %}The patch leaves the bug alive.{% else %}The evidence is insufficient.{% endif %}</h1>
<p>{{ receipt.reason }}</p><p class="muted">{{ receipt.limitation }}</p>
<div class="grid">{% for side in ['baseline','candidate'] %}{% if receipt[side] is defined %}{% set row=receipt[side] %}<section class="card"><h2>{{ 'Original code' if side == 'baseline' else 'Proposed fix' }}</h2><div class="metric" data-testid="{{ side }}-failures"><span data-source="receipt.json#/{{ side }}/target_failures">{{ row.target_failures }}</span> / <span data-source="receipt.json#/{{ side }}/requested_runs">{{ row.requested_runs }}</span></div><p class="muted">runs with the frozen target signature</p><p>Build: {{ 'succeeded' if row.build_ok else 'failed' }} · completed <span data-source="receipt.json#/{{ side }}/completed_runs">{{ row.completed_runs }}</span> runs<br>Other failures: <span data-source="receipt.json#/{{ side }}/unexpected_failures">{{ row.unexpected_failures }}</span></p></section>{% endif %}{% endfor %}</div>
<h2>What was held constant</h2><dl><dt>Oracle</dt><dd>{{ receipt.oracle | default('unavailable') }}</dd><dt>Target signature</dt><dd><code>{{ receipt.signature | default('unavailable') }}</code></dd><dt>Check source</dt><dd>{{ receipt.harness_source | default('unavailable') }}</dd><dt>Bundle SHA-256</dt><dd><code>{{ receipt.bundle_id | default('unavailable') }}</code></dd><dt>Identity pinned</dt><dd>{{ receipt.identity_pinned | default('qualification creates identity') }}</dd><dt>Original SHA-256</dt><dd><code>{{ receipt.baseline_sha256 | default('unavailable') }}</code></dd>{% if receipt.candidate_sha256 is defined %}<dt>Candidate SHA-256</dt><dd><code>{{ receipt.candidate_sha256 }}</code></dd>{% endif %}<dt>Measured at</dt><dd>{{ receipt.created_at }}</dd></dl>
{% for side, output in examples.items() %}<details {% if side=='baseline' %}open{% endif %}><summary>{{ side | capitalize }} · raw failing tool output</summary><pre>{{ output }}</pre></details>{% endfor %}
{% for side in ['baseline','candidate'] %}{% if receipt[side] is defined %}<details><summary>{{ side | capitalize }} · every run</summary><div class="table-wrap"><table><thead><tr><th>Run</th><th>Exit</th><th>Evidence</th><th>Target</th><th>Output</th></tr></thead><tbody>{% for run in receipt[side].runs %}<tr><td data-source="receipt.json#/{{ side }}/runs/{{ loop.index0 }}/index">{{ run.index }}</td><td data-source="receipt.json#/{{ side }}/runs/{{ loop.index0 }}/exit_code">{{ run.exit_code }}</td><td>{{ run.kind }}</td><td>{{ run.matches_target }}</td><td><a href="{{ run.log }}">raw log</a></td></tr>{% endfor %}</tbody></table></div></details>{% endif %}{% endfor %}
<h2>Take the evidence with you</h2><p><a href="receipt.json">Machine-readable receipt</a> · <a href="manifest.json">File integrity manifest</a></p><p class="muted">Runs use disposable source copies. Verification makes no model requests. The manifest detects changed files when checked against a trusted copy; it is not a digital signature.</p>
<p class="footer">A green check applies to this verifier only. A compiler error, unrelated crash, changed baseline, or changed pinned bundle cannot produce VERIFIED.</p>
</main></body></html>
