  "issue": {
    "title": "A timed-out DNS lookup can crash the client",
    "body": "A request whose name lookup runs longer than the connection timeout can crash after the call has already returned. The crash shows up a few seconds later, often while another thread is still finishing the lookup. A short timeout against a name that does not resolve is enough to hit it.",
    "url": "https://github.com/yhirose/cpp-httplib/pull/2232",
    "rewritten": true,
    "mentions_fix": true
  },
